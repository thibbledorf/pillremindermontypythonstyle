<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.thibbledorf.pillreminder</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Pill Reminder.app/Contents/MacOS/PillReminder</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Relaunch on ANY exit: crash, watchdog exit, or "Restart" from the menu. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <!-- Interactive = not throttled like a background daemon. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/PillReminder/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/PillReminder/stdout.log</string>
</dict>
</plist>
